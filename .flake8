[flake8]
exclude = .git,__pycache__,.venv,venv,env,build,dist,interactive_test.py
max-line-length = 127
max-complexity = 15
# Ignore common style issues for now to allow pipeline to pass
# E302: expected 2 blank lines
# W293: blank line contains whitespace
# E501: line too long
# F401: module imported but unused
# F841: local variable assigned but never used
# W291: trailing whitespace
# W292: no newline at end of file
# C901: too complex
# E111, E117: indentation issues
# E306: blank line before nested definition
# E402: imports not at top
# E701: multiple statements on one line
# E722: bare except
# F811: redefinition
# F824: global/nonlocal unused
ignore = E302,W293,E501,F401,F841,W291,E261,E305,W292,C901,E111,E117,E306,E402,E701,E722,F811,F824
extend-ignore = E203
